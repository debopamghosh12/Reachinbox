# Where the backend API runs. Requests are sent with cookies (credentials: "include").
# Local dev: the API's own origin. Leave EMPTY when the API is served from the
# same origin (the Vercel deploy proxies /api, /auth, /admin and /health).
VITE_API_URL=http://localhost:4000

# Vercel only (set in the Vercel project, not here): the Railway URL the
# middleware proxies to, e.g. https://outbox-api.up.railway.app
# BACKEND_URL=
