# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Where the React app runs (used for OAuth redirects back to the UI)
FRONTEND_URL=http://localhost:5173
# Max JSON request size (bounds the leads array of a schedule request)
JSON_BODY_LIMIT=2mb

# ---------- Infra (matches docker-compose.yml) ----------
DATABASE_URL=postgresql://outbox:outbox@localhost:5433/outbox?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails
# Short timeout + no retries: ES is optional for sending, so a slow ES must never hold anything up
ES_REQUEST_TIMEOUT_MS=3000
# Docs per bulk request (scheduling 1000+ leads, reindex)
ES_BULK_BATCH_SIZE=1000

# ---------- Queue / sending limits (nothing is hardcoded in code) ----------
# Parallel jobs per worker process
WORKER_CONCURRENCY=5
# Minimum gap between ANY two sends, enforced queue-wide by the BullMQ limiter
MIN_DELAY_MS=1000
# Hard cap per sender per clock hour (the per-request hourlyLimit can only lower it)
MAX_EMAILS_PER_HOUR_PER_SENDER=50
# Retry policy for transient SMTP failures
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000
# A row stuck in 'sending' longer than this is treated as crashed mid-send and marked
# 'failed' on boot (NOT re-sent: we prefer at-most-once over a possible duplicate)
STUCK_SENDING_THRESHOLD_MS=900000
# Guardrail for a single schedule request
MAX_LEADS_PER_REQUEST=5000
# When an email is pushed to a later hour window, it lands at
# windowStart + seq * RESCHEDULE_SEQ_OFFSET_MS so the original order is kept
RESCHEDULE_SEQ_OFFSET_MS=10
# Rows checked per round trip by reconcile() on boot
RECONCILE_BATCH_SIZE=500
# On SIGINT/SIGTERM, wait this long for in-flight sends before exiting
SHUTDOWN_TIMEOUT_MS=30000
# true = worker skips real SMTP (load tests only)
SMTP_DRY_RUN=false
# How long finished jobs stay in Redis (visible in bull-board) before expiring
JOB_RETENTION_HOURS=168

# ---------- API pagination ----------
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100

# ---------- Seed ----------
SEED_SENDER_COUNT=3

# ---------- Auth ----------
# Signs session cookies and OAuth states. At least 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
# How long a login lasts (cookie max-age and token expiry). 604800000 = 7 days
SESSION_TTL_MS=604800000
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application).
# Add GOOGLE_CALLBACK_URL exactly as written below as an "Authorized redirect URI".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
# How long a "Sign in with Google" link stays valid
GOOGLE_STATE_TTL_MS=600000
# Timeout for every call to Google (code exchange, profile)
GOOGLE_HTTP_TIMEOUT_MS=5000
# Comma-separated emails allowed to open bull-board at /admin/queues (empty = nobody)
ADMIN_EMAILS=

# ---------- Slack (optional: leave empty to disable) ----------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Public HTTPS URL that forwards to this API (Slack only redirects to https),
# e.g. `ngrok http 4000`. The OAuth callback is PUBLIC_BASE_URL/auth/slack/callback,
# and that exact URL must be added under "Redirect URLs" in the Slack app settings.
PUBLIC_BASE_URL=
# How long a "Connect Slack" link stays valid
SLACK_STATE_TTL_MS=600000
# Timeout for every call to Slack (OAuth exchange, webhook post)
SLACK_HTTP_TIMEOUT_MS=5000
